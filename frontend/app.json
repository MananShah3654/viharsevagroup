{
  "expo": {
    "name": "Naranpura Vihar Seva",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "viharseva",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.sevaapp.vsx3ow",
      "associatedDomains": [
        "applinks:naranpuraviharsevagroup.com",
        "applinks:viharsevagroup.vercel.app"
      ],
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Get reminders for your upcoming vihar seva"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#D9772F"
      },
      "package": "com.emergent.sevaapp.vsx3ow",
      "permissions": ["POST_NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "naranpuraviharsevagroup.com", "pathPrefix": "/vihar" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#D9772F"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSansGujarati-Regular.ttf",
            "./assets/fonts/NotoSansGujarati-Medium.ttf",
            "./assets/fonts/NotoSansGujarati-Bold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9772F"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
