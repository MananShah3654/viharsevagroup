{
  "expo": {
    "name": "Naranpura Vihar Seva",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "viharseva",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.sevaapp.vsx3ow",
      "associatedDomains": [
        "applinks:frontend-brown-seven-59cc4o771d.vercel.app",
        "applinks:naranpuraviharsevagroup.com"
      ],
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Get reminders for your upcoming vihar seva"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#D9772F"
      },
      "package": "com.emergent.sevaapp.vsx3ow",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "frontend-brown-seven-59cc4o771d.vercel.app",
              "pathPrefix": "/vihar"
            },
            {
              "scheme": "https",
              "host": "naranpuraviharsevagroup.com",
              "pathPrefix": "/vihar"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#D9772F"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSansGujarati-Regular.ttf",
            "./assets/fonts/NotoSansGujarati-Medium.ttf",
            "./assets/fonts/NotoSansGujarati-Bold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9772F"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "mananshah3654",
    "extra": {
      "eas": {
        "projectId": "34d550f9-ea01-4ba2-8c3c-5dead432f447"
      }
    }
  }
}
