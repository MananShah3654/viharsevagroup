<?xml version="1.0" encoding="utf-8"?>
<!--
    Data Extraction Rules (Android 12+)
    
    Defines what data can be extracted when user transfers app to new device.
    Excludes sensitive WebView data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WebViewCookies.xml" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCache.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WebViewCookies.xml" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCache.db" />
    </device-transfer>
</data-extraction-rules>

